{
  "entities": {
    "Household": {
      "path": "households/{householdId}",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "currency": { "type": "string" },
        "monthlyDiscretionaryBudget": { "type": "number" },
        "createdAt": { "type": "number" }
      }
    },
    "User": {
      "path": "users/{userId}",
      "fields": {
        "id": { "type": "string" },
        "householdId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "initial": { "type": "string" },
        "colorHex": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "Account": {
      "path": "accounts/{accountId}",
      "fields": {
        "id": { "type": "string" },
        "householdId": { "type": "string" },
        "userId": { "type": "string", "optional": true },
        "name": { "type": "string" },
        "holder": { "type": "string" },
        "accountType": { "type": "string" },
        "balance": { "type": "number" },
        "accountNumberMask": { "type": "string" },
        "currency": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    },
    "Transaction": {
      "path": "transactions/{transactionId}",
      "fields": {
        "id": { "type": "string" },
        "householdId": { "type": "string" },
        "userId": { "type": "string", "optional": true },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "paidBy": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "accountId": { "type": "number" },
        "toAccountId": { "type": "number", "optional": true },
        "accountName": { "type": "string" },
        "merchant": { "type": "string" },
        "notes": { "type": "string" },
        "timestamp": { "type": "number" },
        "monthYear": { "type": "string" },
        "nature": { "type": "string" },
        "type": { "type": "string" },
        "isRecurring": { "type": "boolean" },
        "recurringRuleId": { "type": "number", "optional": true }
      }
    },
    "RecurringTransaction": {
      "path": "recurring_transactions/{ruleId}",
      "fields": {
        "id": { "type": "string" },
        "householdId": { "type": "string" },
        "userId": { "type": "string", "optional": true },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "category": { "type": "string" },
        "paidBy": { "type": "string" },
        "type": { "type": "string" },
        "nature": { "type": "string" },
        "dueDay": { "type": "number" },
        "frequency": { "type": "string" },
        "dueMonth": { "type": "number", "optional": true },
        "accountId": { "type": "number" },
        "accountName": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "isActive": { "type": "boolean" }
      }
    }
